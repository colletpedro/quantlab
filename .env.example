# Configuração local do quantlab.
#
#   cp .env.example .env
#
# .env é ignorado pelo git (contém credenciais locais). Este arquivo é a
# documentação versionada de todas as variáveis reconhecidas.

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação — lidas por quantlab.config.Settings (prefixo QUANTLAB_)
# ─────────────────────────────────────────────────────────────────────────────

# String de conexão do MongoDB (ADR-0001).
# Precisa bater com MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD / MONGO_PORT
# abaixo, já que o container sobe com autenticação habilitada.
QUANTLAB_MONGO_URI=mongodb://quantlab:quantlab@localhost:27017/?authSource=admin

# Banco usado para séries OHLCV, eventos corporativos e resultados de backtest.
QUANTLAB_MONGO_DB=quantlab

# Nível mínimo de log: DEBUG | INFO | WARNING | ERROR | CRITICAL.
QUANTLAB_LOG_LEVEL=INFO

# Capital inicial do backtest, em USD (premissa 4 da spec da Fase 1).
QUANTLAB_INITIAL_CAPITAL=100000.0

# Taxa livre de risco anual usada no Sharpe (premissa 7 da spec da Fase 1).
# Default 0. Quando diferente de zero, o relatório deve declarar o valor usado.
QUANTLAB_RISK_FREE_RATE=0.0

# ─────────────────────────────────────────────────────────────────────────────
# Ambiente — lida diretamente por quantlab.logging
# ─────────────────────────────────────────────────────────────────────────────

# dev | development | local | test  -> logs coloridos e legíveis
# qualquer outro valor (ex.: prod)  -> logs em JSON, uma linha por evento
QUANTLAB_ENV=dev

# ─────────────────────────────────────────────────────────────────────────────
# Container do MongoDB — lidas apenas por docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────

# Porta exposta no host. Troque se 27017 já estiver em uso na sua máquina.
MONGO_PORT=27017

# Credenciais do usuário root criado na primeira subida do container.
# Só valem para o ambiente local. Trocar antes de qualquer uso fora da máquina.
MONGO_ROOT_USERNAME=quantlab
MONGO_ROOT_PASSWORD=quantlab
